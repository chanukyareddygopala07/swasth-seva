# ── Root environment (used by docker-compose) ─────────────────────────────
POSTGRES_USER=swasth
POSTGRES_PASSWORD=swasth_secret
POSTGRES_DB=swasthseva
DATABASE_URL=postgresql+asyncpg://swasth:swasth_secret@db:5432/swasthseva
REDIS_URL=redis://redis:6379/0

# ── Backend ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-8f3a9c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SEED_DEMO_DATA=true
AI_MODEL_DIR=/app/ai_models

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=Swasth Seva

# ── External integrations (all optional, app works without them) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Swasth Seva <no-reply@swasthseva.app>
SMS_PROVIDER=abstraction
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
FCM_SERVER_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OSRM_API_URL=https://router.project-osrm.org/route/v1/driving
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# ── Super admin bootstrap ───────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@swasthseva.app
SUPER_ADMIN_PASSWORD=SuperAdmin@123
